# =============================================================================
# IIC v2.1 — environment variable template
# =============================================================================
# Real values live in `.env` (sops-encrypted in repo) and are decrypted at
# boot by `iic-decrypt-secrets.sh` to /run/iic/.env (tmpfs). Never commit
# plaintext .env. See PLAN_v2.1 §13 and 31_PRODUCTION_HARDENING.md §3.

# ---------- LLM (DeepSeek primary, fallbacks) --------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_EMBED_MODEL=bge-m3

# Fallback Pro → Anthropic Claude Sonnet 4.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Fallback Flash → Groq Llama-3.3-70B
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cost circuit breaker (USD/month, hard cap; see PLAN §5)
LLM_MONTHLY_BUDGET_USD=90

# ---------- Market data + macro ---------------------------------------------
POLYGON_API_KEY=
ALPHAV_API_KEY=
TIINGO_API_KEY=
FRED_API_KEY=
TUSHARE_TOKEN=
OPENBB_PAT=

# ---------- Social / news ingest --------------------------------------------
TG_API_ID=
TG_API_HASH=
X_BEARER=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---------- WeChat push (primary) -------------------------------------------
# WeCom group bots (one per channel — briefs, alerts, fills)
WECOM_BOT_BRIEFS_KEY=
WECOM_BOT_ALERTS_KEY=
WECOM_BOT_FILLS_KEY=

# WeCom self-built app (inbound conversational chat)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# Server酱 Turbo (WeChat fallback)
SERVERCHAN_SENDKEY=

# ntfy (tertiary push; self-hosted on the box)
NTFY_BASE_URL=http://ntfy:80
NTFY_TOPIC=iic-alerts

# SMTP (last-resort + weekly digest)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ---------- Backups ----------------------------------------------------------
RESTIC_PASSWORD=
RESTIC_REPOSITORY_LOCAL=/srv/iic/backup-hdd/restic
RESTIC_REPOSITORY_B2=b2:iic-restic
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# ---------- Datastores -------------------------------------------------------
POSTGRES_USER=iic
POSTGRES_PASSWORD=
POSTGRES_DB=iic
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

CHROMA_HOST=chroma
CHROMA_PORT=8000

MINIO_ROOT_USER=iic
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=iic

NATS_URL=nats://nats:4222

# ---------- Tailscale (optional, host-side) ---------------------------------
TAILSCALE_AUTHKEY=

# ---------- Cloudflare Tunnel (optional dashboard exposure) -----------------
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- Misc -------------------------------------------------------------
TZ=America/Los_Angeles
LOG_LEVEL=INFO
